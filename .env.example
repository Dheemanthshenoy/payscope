# PostgreSQL connection string (no credentials committed).
# Example shape only — replace USER/PASSWORD/DB with local values:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/payscope
DATABASE_URL=

# Isolated database for API integration tests (must end with _test).
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/payscope_test
TEST_DATABASE_URL=

# Express API
API_PORT=3001
API_ORIGIN=http://localhost:3001

# Public origin of the Next.js app (used later for CSRF Origin checks)
APP_ORIGIN=http://localhost:3000

# HMAC key for hashing session tokens stored in PostgreSQL (min 16 chars; 32 in production)
SESSION_SECRET=

# Optional: number of reverse-proxy hops to trust for req.ip (unset = do not trust X-Forwarded-*)
# TRUST_PROXY_HOPS=1

# Seeded HR login (used later; leave empty in this scaffold)
HR_EMAIL=
HR_PASSWORD=
