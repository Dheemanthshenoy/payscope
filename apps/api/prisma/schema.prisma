generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

model Department {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  employees Employee[]

  @@map("departments")
}

model Country {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String     @unique @db.Char(2)
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  employees Employee[]

  @@map("countries")
}

model Employee {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeNumber  String           @unique @map("employee_number")
  fullName        String           @map("full_name")
  departmentId    String           @map("department_id") @db.Uuid
  countryId       String           @map("country_id") @db.Uuid
  isActive        Boolean          @default(true) @map("is_active")
  deactivatedAt   DateTime?        @map("deactivated_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  country         Country          @relation(fields: [countryId], references: [id], onDelete: Restrict)
  salaryRevisions SalaryRevision[]
  auditLogs       AuditLog[]

  @@index([departmentId])
  @@index([countryId])
  @@index([isActive])
  @@map("employees")
}

model SalaryRevision {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String     @map("employee_id") @db.Uuid
  amountMinor  BigInt     @map("amount_minor")
  currencyCode String     @map("currency_code") @db.Char(3) // DB CHECK: INR,USD,GBP,AED,EUR
  effectiveOn  DateTime   @map("effective_on") @db.Date
  reason       String?
  version      Int        @default(1) // DB CHECK: version >= 1
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  auditLogs    AuditLog[]

  @@unique([employeeId, effectiveOn], map: "salary_revisions_employee_id_effective_on_key")
  @@map("salary_revisions")
}

model HRUser {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.Citext
  passwordHash String     @map("password_hash")
  role         String     @default("HR")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  auditLogs    AuditLog[]

  @@map("hr_users")
}

model AuditLog {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId          String          @map("actor_id") @db.Uuid
  employeeId       String          @map("employee_id") @db.Uuid
  salaryRevisionId String?         @map("salary_revision_id") @db.Uuid
  action           String
  previousValue    Json?           @map("previous_value")
  newValue         Json            @map("new_value")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  actor            HRUser          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryRevision   SalaryRevision? @relation(fields: [salaryRevisionId], references: [id], onDelete: Restrict)

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
